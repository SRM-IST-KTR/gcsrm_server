# Server Configuration
PORT=8000
NODE_ENV=dev

# Primary Database Configuration (GCSRM - teams, events, sponsors, certificates)
MONGO_URI=mongodb+srv://...
DB_NAME=GCSRM

# Recruitment Database Configuration (Recruitment - recruitment26, tasks26)
MONGO_URI_RECRUITMENT=mongodb+srv://...
DB_NAME_RECRUITMENT=Recruitment

# Recruitment Intake Window (Optional ISO timestamps)
RECRUITMENT_START_DATE=2026-08-01T00:00:00.000Z
RECRUITMENT_END_DATE=2026-12-31T23:59:59.999Z

# Redis & Authentication Configuration
REDIS_URL=redis://localhost:6379
# Upstash REST API (optional; from Vercel Upstash integration)
KV_REST_API_URL=https://<endpoint>.upstash.io
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
JWT_SECRET=your_jwt_secret_here

# CORS Configuration
ORIGIN=*

# Sentry
SENTRY_DSN=

# AWS SES Email Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SENDER_EMAIL=noreply@githubsrmist.in
SES_BATCH_CONCURRENCY=10
AWS_SES_CONFIGURATION_SET=gcsrm-events

# Certificate
CERTIFICATE_SECRET=your_secret_key

# Google Sheet integration (Apps Script Web App for task submissions)
USE_GOOGLE_SHEET_FOR_RECRUITMENT=false
GOOGLE_SHEET_URL=

# Admin/service key: gates every write endpoint and admin-only reads
# (registrant lists, exports, analytics, email dispatch).
# Clients authenticate with header: `Authorization: Bearer <SERVICE_API_KEY>`
SERVICE_API_KEY=your_service_api_key_here

# Public read key: gates display-only read endpoints used by the public sites
# (team, sponsors, events, certificate verify). Safe to ship in a public bundle
# because these endpoints never expose PII and can never mutate state.
# Clients authenticate with header: `Authorization: Bearer <PUBLIC_API_KEY>`
PUBLIC_API_KEY=your_public_read_key_here


ASSIGN_TASK_ENABLED=true